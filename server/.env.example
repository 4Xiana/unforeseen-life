# OpenAI 兼容的 Chat Completions 服务（默认：MiniMax 开放平台 MiniMax-M3）
OPENAI_API_KEY=sk-在此填入你的密钥
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_MODEL=MiniMax-M3

# 后端端口（前端 Vite 固定 5181，并把 /api 代理到本端口）
PORT=5182

# 吱呀语音（密钥仅由服务端使用）
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=qiaopi_mengmei
MINIMAX_API_BASE=https://api.minimaxi.com/v1

# 用户数据独立目录（数据库、喜好、手账和原图）；默认是 server/data
# 服务器更新代码时保留此目录，建议使用固定绝对路径。
# XIAN_DATA_DIR=/var/lib/unforeseen-life

# 配置了 OPENAI_BASE_URL 时默认走 Chat Completions 协议，一般无需设置
# OPENAI_USE_CHAT_COMPLETIONS=true
